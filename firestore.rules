rules_version = '2';

// Each signed-in user may read and write only their own document users/{uid}.
// Nobody can list other users or read another user's bills.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tasks', 'billHistory', 'verifiedSavings', 'verifiedHistory', 'household', 'updatedAt'])
        && request.resource.size() < 64 * 1024;

      // Bill photos the user chose to keep: a compressed JPEG as base64 text.
      match /billImages/{billId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['data', 'type', 'width', 'height', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900 * 1024
          && request.resource.data.type == 'image/jpeg';
      }
    }
  }
}
